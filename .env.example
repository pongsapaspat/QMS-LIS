APP_NAME=QMS-LIS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
TIMEZONE=Asia/Bangkok
DEFAULT_BRANCH_ID=1

# SQLite development default. Override with PostgreSQL in production.
DATABASE_URL=sqlite:///./qms_lis_dev.sqlite3
# DATABASE_URL=postgresql+psycopg://lis_user:change-me@localhost:5432/qms_lis

ENFORCE_FOUR_EYES_CHECK=false
ALLOW_PARTIAL_RELEASE=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

# Never put patient identifiers or clinical results in logs.
LOG_PII=false

