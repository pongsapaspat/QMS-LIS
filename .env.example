QMS_LIS_APP_NAME=QMS-LIS
QMS_LIS_APP_ENV=development
QMS_LIS_DEBUG=true
QMS_LIS_API_V1_PREFIX=/api/v1
QMS_LIS_TIMEZONE=Asia/Bangkok
QMS_LIS_DEFAULT_BRANCH_ID=1

# SQLite development default. Override with PostgreSQL in production.
QMS_LIS_DATABASE_URL=sqlite:///./qms_lis_dev.sqlite3
# QMS_LIS_DATABASE_URL=postgresql+psycopg://lis_user:change-me@localhost:5432/qms_lis

QMS_LIS_ENFORCE_FOUR_EYES_CHECK=false
QMS_LIS_ALLOW_PARTIAL_RELEASE=true
# Development convenience only. Set false outside local development.
QMS_LIS_ENABLE_DEV_ADMIN_FALLBACK=true
QMS_LIS_LOG_LEVEL=INFO

# Never put patient identifiers or clinical results in logs.
QMS_LIS_LOG_PII=false

