QMS_LIS_APP_NAME=QMS-LIS
QMS_LIS_APP_ENV=development
QMS_LIS_DEBUG=true
QMS_LIS_API_V1_PREFIX=/api/v1
QMS_LIS_TIMEZONE=Asia/Bangkok
QMS_LIS_DEFAULT_BRANCH_ID=1

# SQLite development default. Override with PostgreSQL in production.
QMS_LIS_DATABASE_URL=sqlite:///./qms_lis_dev.sqlite3
# QMS_LIS_DATABASE_URL=postgresql+psycopg://lis_user:change-me@localhost:5432/qms_lis

QMS_LIS_ENFORCE_FOUR_EYES_CHECK=false
# Requires both an ADMIN actor and an explicit bypass request; every bypass is audited.
QMS_LIS_ALLOW_ADMIN_FOUR_EYES_BYPASS=false
QMS_LIS_ALLOW_PARTIAL_RELEASE=true
# Development convenience only. Set false outside local development.
QMS_LIS_ENABLE_DEV_ADMIN_FALLBACK=true

# Session security. Use a long random value outside local development.
QMS_LIS_SESSION_SECRET=replace-with-a-long-random-secret
QMS_LIS_SESSION_IDLE_TIMEOUT_SECONDS=1800
QMS_LIS_MAX_ACTIVE_SESSIONS=7
QMS_LIS_SESSION_MAX_AGE_SECONDS=28800
# Set true only when the application is served over HTTPS.
QMS_LIS_SESSION_HTTPS_ONLY=false
QMS_LIS_LOGIN_FAILURE_LIMIT=5
QMS_LIS_LOGIN_FAILURE_WINDOW_SECONDS=900
QMS_LIS_ACCOUNT_LOCKOUT_SECONDS=900

# Optional first administrator bootstrap. Remove after the first account is created.
QMS_LIS_BOOTSTRAP_ADMIN_USERNAME=admin
QMS_LIS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

QMS_LIS_LOG_LEVEL=INFO

# Never put patient identifiers or clinical results in logs.
QMS_LIS_LOG_PII=false

